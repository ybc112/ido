# ═════════ 前端（Vercel 上配置 VITE_* 环境变量） ═════════

# 出海 IDO 预售配置
VITE_IDO_RECEIVER_ADDRESS=0x315bDFE49A90113DFf636a63489b928273c826F9
VITE_IDO_SOFT_CAP=20
VITE_IDO_HARD_CAP=40

# 出海捕鱼（部署 FishGameVault 后填真实地址）
VITE_FISHING_VAULT_ADDRESS=
VITE_FISHING_GAME_TOKEN=0x839578f40b9a79a3fe891dd96079f3083e6e7777
# 捕鱼后端入口（Cloudflare 隧道 → 服务器 8800）
VITE_FISHING_BACKEND_URL=https://fishing.kimi-vault.com

# ═════════ 后端（服务器 .env） ═════════

# 捕鱼金库合约地址（部署后填）
FISHING_VAULT_ADDRESS=
# 签名钱包私钥（必须是合约 signer() 那个地址，与部署钱包分开）
FISHING_SIGNER_PRIVATE_KEY=
# 游戏代币（默认 CAPY）
FISHING_GAME_TOKEN=0x839578f40b9a79a3fe891dd96079f3083e6e7777
# RPC（默认 rpc-bsc.48.club，自动故障转移）
FISHING_RPC_URL=https://rpc-bsc.48.club
# 事件监听起始块（合约部署块号）
FISHING_START_BLOCK=0
# 目标返还率（0.4 = 40%）
FISHING_RTP=0.4
# 最小下分（代币数量）
FISHING_MIN_WITHDRAW=10
# 监听端口
FISHING_BACKEND_PORT=8800

# ═════════ 合约部署（本地 .env） ═════════
# 部署钱包私钥（也是合约 owner）
PRIVATE_KEY=
# 单笔下分上限（wei，0=不限）
FISHING_MAX_CLAIM_PER_TX=0
# 单地址每日下分上限（wei，0=不限）
FISHING_DAILY_CLAIM_CAP=0
